---
---

<div id="autocomplete" class="w-full max-w-2xl mx-auto relative"></div>

<script>
  import { autocomplete, getAlgoliaResults } from '@algolia/autocomplete-js';
  import { algoliasearch } from "algoliasearch";
  const detached = true; // Set to true to enable detached mode

  const searchClient = algoliasearch(
    import.meta.env.PUBLIC_ALGOLIA_APP_ID,
    import.meta.env.PUBLIC_ALGOLIA_SEARCH_API_KEY
    );

  const search = autocomplete({
    container: '#autocomplete',
    placeholder: "Search meals ...",
    detachedMediaQuery: detached ? 'none' : '', // Always detached if true
    openOnFocus: true,
    showLoadingIndicator: false,
    getSources({ query }) {
      return [
        // Main content results
        {
          sourceId: 'articles',
          getItems() {
            return getAlgoliaResults({
              searchClient,
              queries: [
                {
                  indexName: "astro_mealsdb_content",
                  query,
                  params: {
                    hitsPerPage: 8,
                  },
                },
              ],
            });
          },
          templates: {
            header() {
              return 'Meals & Recipes';
            },
            item({ item, components, html }) {
              return html`
                <a href="${item.url}" class="block p-3 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg transition-colors group">
                  <div class="flex items-center space-x-3">
                    ${item.thumbnail ? html`
                      <div class="flex-shrink-0">
                        <img 
                          src="${item.thumbnail}" 
                          alt="${item.title}" 
                          class="w-12 h-12 rounded-lg object-cover border border-gray-200 dark:border-gray-700"
                        />
                      </div>
                    ` : html`
                      <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900 dark:to-blue-800 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                      </div>
                    `}
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                        ${components.Highlight({
                          hit: item,
                          attribute: 'title',
                        })}
                      </div>
                      ${item.category ? html`
                        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                            ${item.category}
                          </span>
                        </div>
                      ` : ''}
                    </div>
                    <div class="flex-shrink-0">
                      <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </div>
                  </div>
                </a>
              `;
            },
            noResults() {
              return 'No recipes found. Try a different search term.';
            },
          },
        },
        
        // Query suggestions (recent/popular searches)
        {
          sourceId: 'querySuggestionsPlugin',
          getItems() {
            return getAlgoliaResults({
              searchClient,
              queries: [
                {
                  indexName: "astro_mealsdb_content",
                  query,
                  params: {
                    hitsPerPage: 4,
                    attributesToRetrieve: ['title'],
                    distinct: true,
                  },
                },
              ],
            });
          },
          templates: {
            header() {
              return 'Suggestions';
            },
            item({ item, components, html }) {
              return html`
                <div class="">
                  <div class="flex items-center gap-2">
                    <div class="inline-flex size-6 items-center justify-center">
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z"></path></svg>
                    </div>
                    <div class="">
                      <div class="">
                        ${components.Highlight({
                          hit: item,
                          attribute: 'title',
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              `;
            },
          },
          onSelect({ item, setQuery, setIsOpen, refresh }) {
            setQuery(item.title);
            setIsOpen(true);
            refresh();
          },
        },

        // Categories filter
        // {
        //   sourceId: 'categories',
        //   getItems() {
        //     return getAlgoliaResults({
        //       searchClient,
        //       queries: [
        //         {
        //           indexName: "astro_mealsdb_content",
        //           query,
        //           params: {
        //             hitsPerPage: 0,
        //             facets: ['category'],
        //           },
        //         },
        //       ],
        //     }).then((results) => {
        //       const facets = results[0]?.facets?.category || {};
        //       return Object.entries(facets)
        //         .map(([value, count]) => ({ value, count, label: value }))
        //         .slice(0, 5);
        //     });
        //   },
        //   templates: {
        //     header() {
        //       return 'Categories';
        //     },
        //     item({ item, html }) {
        //       return html`
        //         <div class="aa-ItemWrapper">
        //           <div class="aa-ItemContent">
        //             <div class="aa-ItemIcon aa-ItemIcon--noBorder">
        //               📁
        //             </div>
        //             <div class="aa-ItemContentBody">
        //               <div class="aa-ItemContentTitle">
        //                 ${item.label}
        //               </div>
        //               <div class="aa-ItemContentDescription">
        //                 ${item.count} items
        //               </div>
        //             </div>
        //           </div>
        //         </div>
        //       `;
        //     },
        //   },
        //   onSelect({ item, setQuery, setIsOpen, refresh }) {
        //     // Navigate to category page or filter by category
        //     window.location.href = `/search?category=${encodeURIComponent(item.value)}`;
        //   },
        // },
      ];
    },
    
    // Navigate to item on select
    navigator: {
      navigate({ itemUrl }) {
        window.location.href = itemUrl;
      },
      navigateNewTab({ itemUrl }) {
        const windowReference = window.open(itemUrl, '_blank', 'noopener');
        if (windowReference) {
          windowReference.focus();
        }
      },
      navigateNewWindow({ itemUrl }) {
        window.open(itemUrl, '_blank', 'noopener');
      },
    },
  });
</script>

<style is:global>
    @import '@algolia/autocomplete-theme-classic';
</style>