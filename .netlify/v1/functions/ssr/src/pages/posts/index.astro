---
export const prerender = false;

import { getCollection } from 'astro:content';

//import layout
import Layout from 'src/layouts/Layout.astro';

// Get page from search params
const url = new URL(Astro.request.url);
const pageParam = url.searchParams.get('page');
const currentPage = pageParam ? parseInt(pageParam) : 1;
const sortParam = url.searchParams.get('sort');

// Get all posts
const allPosts = await getCollection('posts');

// Sort posts by date (newest first)
const sortedPosts = allPosts.sort((a, b) => 
    sortParam === "newest"
    ? new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    : new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime()
);

// Pagination logic
const postsPerPage = 2;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

// Ensure currentPage is within valid range
const validPage = Math.max(1, Math.min(currentPage, totalPages));

// Calculate slice indices
const start = (validPage - 1) * postsPerPage;
const end = start + postsPerPage;

// Get posts for current page
const posts = sortedPosts.slice(start, end);

// Navigation helpers
const hasNext = validPage < totalPages;
const hasPrev = validPage > 1;
---

<Layout title="Blog Posts" description="Read the latest articles and updates on our blog.">
    <div class="flex items-center justify-between mb-4">
      <h1>Blog Posts - Page {validPage} of {totalPages}</h1>

    <form method="get" id="sorting-form">
      <select
        name="sort"
        id="sorting"
        value={url.searchParams.get('sort') || 'newest'}
      >
        <option value="newest" selected={url.searchParams.get('sort') !== 'oldest'}>Newest First</option>
        <option value="oldest" selected={url.searchParams.get('sort') === 'oldest'}>Oldest First</option>
      </select>
      <input type="hidden" name="page" value={validPage} />
    </form>
    </div>
    
    <div class="posts">
      {posts.map((post) => (
        <article>
          <h2>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p>{new Date(post.data.pubDate).toLocaleDateString()}</p>
          <p>{post.data.description}</p>
        </article>
      ))}
    </div>
    
    <nav class="pagination">
      {hasPrev && (
        <a
          href={`?${(() => {
            const params = new URLSearchParams(url.searchParams);
            params.set('page', (validPage - 1).toString());
            return params.toString();
          })()}`}
        >← Previous</a>
      )}
      
      <div class="page-numbers">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((num) => (
          <a
            href={`?${(() => {
              const params = new URLSearchParams(url.searchParams);
              params.set('page', num.toString());
              return params.toString();
            })()}`}
            class={num === validPage ? 'active' : ''}
          >
            {num}
          </a>
        ))}
      </div>
      
      {hasNext && (
        <a
          href={`?${(() => {
            const params = new URLSearchParams(url.searchParams);
            params.set('page', (validPage + 1).toString());
            return params.toString();
          })()}`}
        >Next →</a>
      )}
    </nav>
    
    <script>
        document.getElementById('sorting').addEventListener('change', function(e) {
            const url = new URL(window.location);
            url.searchParams.set('sort', e.target.value);
            window.location.href = url.toString();
        });
    </script>

    <style>
      .posts {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 2rem 0;
      }
      
      article {
        padding: 1.5rem;
        border: 1px solid #ddd;
        border-radius: 8px;
      }
      
      .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin: 2rem 0;
      }
      
      .page-numbers {
        display: flex;
        gap: 0.5rem;
      }
      
      .page-numbers a {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        text-decoration: none;
      }
      
      .page-numbers a.active {
        background: #0066cc;
        color: white;
        border-color: #0066cc;
      }
    </style>
</Layout>