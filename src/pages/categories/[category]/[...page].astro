---
//export const prerender = false;
import { getCollection, render } from "astro:content";

//layout import
import Layout from "src/layouts/Layout.astro";
import Pagination from "@/components/Pagination.astro";

//components import
import MealsCard from "src/components/blocks/MealsCard.astro";
import SimpleMealCard from "src/components/blocks/SimpleMealCard.astro";

//fetch categories for category tags
const categories = await getCollection("categories");

//generate static paths for each category
export async function getStaticPaths({ paginate }) {
  //getting categories collection to generate paths
  const categories = await getCollection("categories");

  //get all recipes
  const allRecipes = await getCollection("recipes");

  //generate paths for each category with pagination
  return categories.flatMap((category) => {
    //filter recipes for this category
    const categoryRecipes = allRecipes
      .filter(
      (recipe) =>
        recipe.data.category.toLocaleLowerCase() ===
        category.data.slug.toLocaleLowerCase()
      )
      .sort((a, b) => a.data.title.localeCompare(b.data.title));

    //return paginated paths for this category
    return paginate(categoryRecipes, {
      params: { category: category.data.slug },
      props: { category: categoryRecipes, selectedCategory: category.data },
      pageSize: 10,
    });
  });
}

//get sort parameter from URL
const url = new URL(Astro.request.url);
const sortParam = url.searchParams.get("sort") || "a-z";

console.log("Sort Param:", sortParam);

//get selected category
const { category } = Astro.params;
const { selectedCategory, page } = Astro.props;
console.log("Selected Category:", selectedCategory);

const recipiesData = page?.data;

//const selectedCategorySlug = selectedCategory.slug.toLocaleLowerCase();
//fetch recipes based on selected category
