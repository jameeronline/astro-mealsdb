---
/* @jsxImportSource astro */
import type { Category, Cuisine } from "../../data/recipes";

//icons
import { LayoutGrid, LayoutList, ChevronLeft, ChevronRight } from "@lucide/astro";

interface Props {
  categories: Category[];
  cuisines: Cuisine[];
}

//import UISelect from "../ui/UISelect.astro";
import Select from "@/components/ui/Select.astro";

import { getCollection } from "astro:content";

//get all recipes
const allRecipes = await getCollection("recipes");

// Get 12 random recipes from the "recipes" collection
const shuffled = allRecipes.sort(() => 0.5 - Math.random());
const randomRecipes = shuffled.slice(0, 12);

//get random meals
const randomMeal = allRecipes[Math.floor(Math.random() * allRecipes.length)];

//components
import Card from "@/components/ui/Card.astro";
import MealCard from "@/components/blocks/MealCard.astro";

//props
const { categories, cuisines } = Astro.props;

const categoryOptions = categories.map((category) => ({
  label: category.title,
  value: category.slug,
}));

const cuisineOptions = cuisines.map((cuisine) => ({
  label: cuisine.title,
  value: cuisine.slug,
}));
---

<!-- Filterable Meal Grid -->
<section class="py-12" data-scroll-animate>
  <!-- Section Header -->
  <h2
    class="font-heading text-text-light dark:text-text-dark text-[22px] font-bold leading-tight tracking-[-0.015em] pb-4"
    data-scroll-animate
  >
    Discover Meals
  </h2>
  <!-- Filters and Toolbar -->
  <div
    class="flex flex-col justify-between items-start md:items-center gap-4 py-3 border-y border-border-light dark:border-border-dark mb-8"
    data-scroll-animate
  >
    <div class="flex flex-wrap justify-between w-full gap-3">
      <div class="flex">
        <Select
          options={categoryOptions}
          id="category-select"
          name="category-select"
          placeholder="Category"
        />
        <Select
          options={cuisineOptions}
          id="cuisine-select"
          name="cuisine-select"
          placeholder="Cuisine"
        />
      </div>
      <div class="hidden md:flex items-center gap-2">
        <p class="text-sm font-medium mr-2 hidden sm:block">View:</p>
        <button class="p-2 rounded-lg bg-primary/20 text-primary">
          <LayoutGrid class="size-6" />
        </button>
        <button
          class="p-2 rounded-lg hover:bg-primary/20 text-text-light dark:text-text-dark/70 hover:text-primary dark:hover:text-primary transition-colors"
        >
          <LayoutList class="size-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Meal Grid -->
  <!-- <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
  >
    {
      randomRecipes.map((meal) => (
        <Card
          title={meal.data.title}
          imageUrl={meal.data.thumbnail}
          imageAlt={meal.data.title}
          category={meal.data.category}
          cuisine={meal.data.cuisine}
          href={`/recipe/${meal.data.slug}`}
        />
      ))
    }
  </div> -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
  >
    {
      randomRecipes.map((meal) => (
        <MealCard
          image={meal.data.thumbnail}
          imageAlt={meal.data.title}
          category={meal.data.category}
          cuisine={meal.data.cuisine}
          title={meal.data.title}
          description={meal.data.description}
          time={meal.data.addons.totalTime}
          difficulty={meal.data.addons.difficulty}
          rating={meal.data.rating}
          href={`/recipe/${meal.data.slug}`}
        />
      ))
    }
  </div>
  <!-- Pagination -->
  <nav aria-label="Pagination" class="flex items-center justify-center pt-16">
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg border border-border-light dark:border-border-dark text-sm font-medium hover:bg-primary/20 transition-colors"
      href="#"
    >
      <ChevronLeft class="size-6" />
    </a>
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg bg-primary text-text-light text-sm font-bold mx-1"
      href="#">1</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">2</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">3</a
    >
    <span
      class="inline-flex items-center justify-center size-9 text-sm font-medium mx-1"
      >...</span
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">10</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg border border-border-light dark:border-border-dark text-sm font-medium hover:bg-primary/20 transition-colors"
      href="#"
    >
      <ChevronRight class="size-6" />
    </a>
  </nav>
</section>
