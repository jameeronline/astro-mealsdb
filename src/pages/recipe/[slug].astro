      </div>
      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Ingredients & Instructions -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Ingredients Card -->
          <Ingredients ingredients={ingredients} />
          
          <!-- Instructions Card -->
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm print:p-0 print:shadow-none print:text-black">
