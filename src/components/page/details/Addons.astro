---
interface Props {
    addons: {
        servings: string;
        prepTime: string;
        cookTime: string;
        difficulty?: string;
        totalTime?: string;
    };
}

const { addons } = Astro.props;

//destructure addons
const { servings, prepTime, cookTime } = addons;
---

<div class="flex items-center w-full justify-between gap-4 md:gap-6 md:w-auto md:justify-end">
{[
    { label: 'Servings',  value: servings },
    { label: 'Prep Time', value: prepTime },
    { label: 'Cook Time', value: cookTime }
].map((item, i) => (
    <>
        <div class="text-center flex-1 md:flex-none">
            <p class="text-xs text-gray-600 dark:text-gray-400 uppercase font-semibold">{item.label}</p>
            <p class="text-lg font-bold text-gray-900 dark:text-gray-100">
                {item.value}{item.label === 'Prep Time' || item.label === 'Cook Time' ? ' min' : ''}
            </p>
        </div>
        {i < 2 && <div class="border-l h-8 border-gray-300 dark:border-gray-600"></div>}
    </>
))}
</div>
