---
import { getCollection, render } from "astro:content";
import Image from "astro/components/Image.astro";

//layout import
import Layout from "src/layouts/Layout.astro";

//components import
import MealsCard from "src/components/blocks/MealsCard.astro";
import SimpleMealCard from "src/components/blocks/SimpleMealCard.astro";

//fetch categories for category tags
const categories = await getCollection("categories");

//generate static paths for each category
export async function getStaticPaths() {
  const categories = await getCollection("categories");

  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category: category.data },
  }));
}

//props
const { category } = Astro.props;
const selectedCategory = category.slug.toLocaleLowerCase();

//fetch recipes based on selected category
const allRecipes = await getCollection("recipes");
const categoryRecipes = allRecipes.filter(recipe => 
  recipe.data.category.toLocaleLowerCase() === selectedCategory
);

//get selected category content
const selectedCategoryData = categories.find(cat => 
  cat.data.slug.toLocaleLowerCase() === selectedCategory
);
const { Content } = await render(selectedCategoryData);
---

<Layout title={category.title} description={`Explore delicious recipes in the ${category.title} category.`} >
    <!-- Category Header -->
    <div class="flex flex-wrap justify-center gap-3 py-4 mb-6 max-w-4xl mx-auto text-center">
      <div class="flex flex-col gap-3">
        <p
          class="text-text-light dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]"
        >
          Browse {category.title && category.title} Category Recipes 
        </p>
        <p class="text-primary capitalize">{categoryRecipes.length} results found</p>
        <div
          class="text-text-light/60 dark:text-text-dark/60 text-base font-normal leading-normal"
        >
          <Content />
        </div>
      </div>
    </div>
    <!-- Category Tags -->
    <div class="flex justify-center gap-3 py-3 mb-6">
      {
        categories.map((category) => (
          <a
            href={`/category/${category.data.slug}`}
            page-active={
              category.data.slug === selectedCategory ? "true" : "false"
            }
            class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full bg-card-light dark:bg-card-dark px-5 hover:bg-primary/20 hover:border-primary-dark transition-colors border border-border-light dark:border-card-dark  [&[page-active='true']]:text-background-dark [&[page-active='true']]:border-primary  [&[page-active='true']]:bg-primary"
          >
            <span class="text-sm font-medium leading-normal">
              {category.data?.title && category.data.title}
            </span>
          </a>
        ))
      }
    </div>
    <!-- Recipe Grid -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6 py-4" data-scroll-animate>
      {
        categoryRecipes.map((recipe) => (
          <MealsCard recipe={recipe.data} />
          // <SimpleMealCard recipe={recipe.data} />
        ))
      }
    </div>
</Layout>
