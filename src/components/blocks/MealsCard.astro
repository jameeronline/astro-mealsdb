---
import Image from "astro/components/Image.astro";
const { recipe } = Astro.props;

// Destructure hit object
const { title, description, slug, thumbnail, addons, category, cuisine } =
  recipe;
---

<div class="flex flex-col gap-3 pb-3 group" data-scroll-animate>
    <div
        class="w-full bg-center bg-no-repeat aspect-square md:aspect-[3/4] bg-cover rounded-xl overflow-hidden"
         data-scroll-animate
    >
        {
            thumbnail ? (
                <Image
                    class="w-full h-full bg-center bg-no-repeat object-cover group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    src={thumbnail}
                    alt={title}
                    width={400}
                    height={533}
                />
            ) : (
                <Image
                    class="w-full h-full bg-center bg-no-repeat object-cover group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    src="/fallback-image.jpg"
                    alt={title}
                    width={400}
                    height={533}
                />
            )
        }
    </div>
    <div  data-scroll-animate>
        <p class="text-text-light dark:text-text-dark text-base font-medium leading-normal">
            {title}
        </p>
        <p class="text-text-muted-light dark:text-text-muted-dark text-sm font-normal leading-normal">
            <!-- {category ? `${category}` : category} -->
            {cuisine ? `${cuisine}` : cuisine}
            {addons?.cookTime && `, ${addons.cookTime} min`}
        </p>
        <a
            class="text-primary text-sm font-medium leading-normal mt-1 block hover:underline"
            href={`/recipe/${slug}`}>View Recipe</a
        >
    </div>
</div>
