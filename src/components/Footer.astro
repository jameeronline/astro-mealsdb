---
interface FooterLink {
  text: string;
  url: string;
}

interface FooterSection {
  title: string;
  links: FooterLink[];
}

const linkPrefix = "/static";

const footerSections: FooterSection[] = [
  {
    title: "Quick Links",
    links: [
      { text: "Home", url: "/" },
      { text: "Categories", url: "/categories" },
      { text: "Blog", url: "/blog" },
      { text: "About Us", url: "/about" }
    ]
  },
  {
    title: "Legal",
    links: [
      { text: "Privacy Policy", url: "/privacy-policy" },
      { text: "Terms and Conditions", url: "/terms-and-conditions" },
      { text: "Contact Us", url: "/contact" }
    ]
  }
];
---

<!-- Footer -->
<footer
  class="bg-card-light dark:bg-card-dark border-t border-border-light dark:border-border-dark mt-16"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-primary text-2xl"
            >ramen_dining</span
          >
          <h2 class="text-text-light dark:text-text-dark text-lg font-bold">
            MealsDB
          </h2>
        </div>
        <p class="text-sm max-w-sm">
          Your ultimate destination for discovering, cooking, and sharing
          delicious meals from around the world.
        </p>
      </div>
      {footerSections.map((section) => (
        <div>
          <h3 class="font-bold mb-4">{section.title}</h3>
          <ul class="space-y-2 text-sm">
            {section.links.map((link) => (
              <li>
                <a class="hover:text-primary transition-colors" href={`${linkPrefix}${link.url}`}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div
      class="mt-12 pt-8 border-t border-border-light dark:border-border-dark text-center text-sm"
    >
      <p>© 2024 MealsDB. All rights reserved.</p>
    </div>
  </div>
</footer>
