---
import { getCollection, getEntry, render } from "astro:content";
import Image from "astro/components/Image.astro";

//layout import
import Layout from "src/layouts/Layout.astro";

//components import
import Header from "@/components/page/details/Header.astro";
import Actions from "@/components/page/details/Actions.astro";
import Addons from "@/components/page/details/Addons.astro";
import Ingredients from "@/components/page/details/Ingredients.astro";
import NutritionInfo from "@/components/page/details/NutritionInfo.astro";
import Reviews from "@/components/page/details/Reviews.astro";

//fetch meal details based on slug
const recipes = await getCollection("recipes");

//find the recipe that matches the slug
export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({
    params: { slug: recipe.data.slug },
    props: { recipe: recipe.data },
  }));
}

const { recipe } = Astro.props;

//extract data from the recipe
const { title, ingredients, addons, nutrition, thumbnail, description } = recipe;

const entry = await getEntry("recipes", recipe.slug);
const { Content } = await render(entry);
