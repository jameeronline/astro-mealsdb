        </div>
      </div>
      <div class="flex flex-col gap-3 pb-3 group">
        <div
          class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-xl overflow-hidden"
        >
          <div
            class="w-full h-full bg-center bg-no-repeat bg-cover group-hover:scale-110 transition-transform duration-300 ease-in-out"
            data-alt="A colorful fruit tart with fresh berries and kiwi"
            style="
                        background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuApW9Blqf-ThILqs2W7-IPOviNUPu9iRiHNpiZiAF_KXw0VoNLZkt2VVwCJLsPpll5jquCFxLG6FGffUH0sGqT4L8iMPiKa1zTBEQBEBhwx2yyazFB2W-d7HkQOKV22Bek0LJ_ynMMr3KDLgiFmQzwXc6rvsJw08oKM2BUto8nZ2xKDZfYiOHTfEaGxXfNSZFChXUTfLu02W_LtTHzYQxPiUJdT8eQwd00iL7toLD10AeTEBQ3-ckAO4Vs8kXWuthaT9XAyMCpWTXHG');
                      "
          >
          </div>
        </div>
        <div>
          <p
            class="text-text-light dark:text-white text-base font-medium leading-normal"
          >
            Fruit Tart
          </p>
          <p
            class="text-text-muted-light dark:text-[#a3b99d] text-sm font-normal leading-normal"
          >
            French, 50 mins
          </p>
          <a
            class="text-primary text-sm font-medium leading-normal mt-1 block hover:underline"
            href="#">View Recipe</a
          >
        </div>
      </div>
      <div class="flex flex-col gap-3 pb-3 group">
        <div
          class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-xl overflow-hidden"
        >
          <div
            class="w-full h-full bg-center bg-no-repeat bg-cover group-hover:scale-110 transition-transform duration-300 ease-in-out"
            data-alt="Crispy Belgian waffles with strawberries and syrup"
            style="
                        background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAf9_WaNa8MWz5JXoyKTATrzmSFdpMrRoPNJ7FQbWkB_O323d9s7-DatTYX9HCdiorSKNlbwOnxNVR7osR0-HjnErmq_1SKFhMjdw79O7jAc8zFKzvOfbng1Km9Gq4CzEqECfDIw2AOCQ9r8Nje5cFcucKp8s-x2vsSb5fWAqtqRHvr0phL-9XGzSnImwiQC1EB4YCOsdmVPqm_OBpM6zEXZN153k-wA1O9zaUzPkNY1YoTBz1zf2l49c_b_qM2K_YCO8nLpFCttWcX');
                      "
          >
          </div>
        </div>
        <div>
          <p
            class="text-text-light dark:text-white text-base font-medium leading-normal"
          >
            Belgian Waffles
          </p>
          <p
            class="text-text-muted-light dark:text-[#a3b99d] text-sm font-normal leading-normal"
          >
            Belgian, 20 mins
          </p>
          <a
            class="text-primary text-sm font-medium leading-normal mt-1 block hover:underline"
            href="#">View Recipe</a
          >
        </div>
      </div>
    </div>
    <div class="flex justify-center items-center gap-2 py-4 mt-8">
      <button
        class="flex items-center justify-center h-10 px-4 rounded-lg bg-card-light dark:bg-card-dark text-text-light dark:text-white text-sm font-medium hover:bg-zinc-100 dark:hover:bg-card-dark/70 transition-colors disabled:opacity-50 disabled:cursor-not-allowed border border-border-light dark:border-card-dark"
        disabled=""
      >
        Previous
      </button>
      <button
        class="flex items-center justify-center size-10 rounded-lg bg-card-light dark:bg-card-dark text-text-light dark:text-white text-sm font-medium hover:bg-zinc-100 dark:hover:bg-card-dark/70 transition-colors border border-border-light dark:border-card-dark"
      >
        1
      </button>
      <button
        class="flex items-center justify-center size-10 rounded-lg bg-primary text-background-dark text-sm font-bold"
      >
        2
      </button>
      <button
        class="flex items-center justify-center size-10 rounded-lg bg-card-light dark:bg-card-dark text-text-light dark:text-white text-sm font-medium hover:bg-zinc-100 dark:hover:bg-card-dark/70 transition-colors border border-border-light dark:border-card-dark"
      >
        3
      </button>
      <button
        class="flex items-center justify-center h-10 px-4 rounded-lg bg-card-light dark:bg-card-dark text-text-light dark:text-white text-sm font-medium hover:bg-zinc-100 dark:hover:bg-card-dark/70 transition-colors border border-border-light dark:border-card-dark"
      >
        Next
      </button>
    </div>
  </div>
</Layout>
