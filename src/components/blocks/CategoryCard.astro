---
import { Image } from "astro:assets";

interface CategoryCardProps {
    item: {
        data: {
            title: string;
            slug: string;
            thumbnail: string;
        };
    };
    type: string;
}

const { item, type } = Astro.props as CategoryCardProps;

---

<a
    class="group relative block overflow-hidden rounded-xl"
    href={`/${type}/${item.data.slug}`}
    data-scroll-animate
>
    <div
        class="flex flex-col justify-end aspect-3/4 transition-transform duration-300 ease-in-out group-hover:scale-105"
    >
        <div
            class="absolute left-0 right-0 bottom-0 h-1/3 bg-linear-t from-black/70 to-transparent"
        ></div>
        <Image
            class="h-full w-full object-cover"
            alt={item.data.title}
            src={item.data.thumbnail}
            width={400}
            height={540}
        />
        <h2
            class="text-white text-lg font-bold leading-tight absolute bottom-4 left-4"
        >
            {item.data.title}
        </h2>
    </div>
</a>
