---
import { getCollection, render } from "astro:content";
import Image from "astro/components/Image.astro";

//layout import
import Layout from "src/layouts/Layout.astro";

//components import
import MealsCard from "src/components/blocks/MealsCard.astro";
import SimpleMealCard from "src/components/blocks/SimpleMealCard.astro";

//fetch categories for category tags
const cuisines = await getCollection("cuisines");

//generate static paths for each category
export async function getStaticPaths() {
  const cuisines = await getCollection("cuisines");

  return cuisines.map((cuisine) => ({
    params: { cuisine: cuisine.data.slug },
    props: { cuisine: cuisine.data },
  }));
}

//props
const { cuisine } = Astro.props;
const selectedCuisine = cuisine.slug.toLocaleLowerCase();

//fetch recipes based on selected category
const allRecipes = await getCollection("recipes");
const cuisineRecipes = allRecipes.filter(recipe => 
  recipe.data.cuisine.toLocaleLowerCase() === selectedCuisine
);

//get selected cuisine content
const selectedCuisineData = cuisines.find(cui => 
  cui.data.slug.toLocaleLowerCase() === selectedCuisine
);
const { Content } = await render(selectedCuisineData);
---

<Layout title={cuisine.title} description={`Explore delicious recipes in the ${cuisine.title} cuisine.`} >
    <!-- Category Header -->
    <div class="flex flex-wrap justify-center gap-3 py-4 mb-6 max-w-4xl mx-auto text-center">
      <div class="flex flex-col gap-3">
        <p
          class="text-text-light dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]"
        >
          Browse {cuisine.title && cuisine.title} Cuisine Recipes 
        </p>
        <p class="text-primary capitalize">{cuisineRecipes.length} results found</p>
        <div
          class="text-text-light/60 dark:text-text-dark/60 text-base font-normal leading-normal"
        >
          <Content />
        </div>
      </div>
    </div>
    <!-- Category Tags -->
    <div class="flex justify-center gap-3 py-3 mb-6">
      {
        cuisines.map((cuisine) => (
          <a
            href={`/cuisines/${cuisine.data.slug}`}
            page-active={
              cuisine.data.slug === selectedCuisine ? "true" : "false"
            }
            class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full bg-card-light dark:bg-card-dark px-5 hover:bg-primary/20 hover:border-primary-dark transition-colors border border-border-light dark:border-card-dark  [&[page-active='true']]:text-background-dark [&[page-active='true']]:border-primary  [&[page-active='true']]:bg-primary"
          >
            <span class="text-sm font-medium leading-normal">
              {cuisine.data?.title && cuisine.data.title}
            </span>
          </a>
        ))
      }
    </div>
    <!-- Recipe Grid -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6 py-4" data-scroll-animate>
      {
        cuisineRecipes.map((recipe) => (
          <MealsCard recipe={recipe.data} />
          // <SimpleMealCard recipe={recipe.data} />
        ))
      }
    </div>
</Layout>
