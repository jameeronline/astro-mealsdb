---
// src/pages/404.astro
import Layout from "src/layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <main class="grid place-items-center px-8">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-red-600 mb-4">404</h1>
      <p class="text-2xl mb-8">Oops! We couldn't find that page.</p>
      <a 
        href="/" 
        class="inline-block px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition"
      >
        Go back home
      </a>
    </div>
  </main>
</Layout>