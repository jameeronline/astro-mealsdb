---
import Layout from "src/layouts/Layout.astro";

//icons
import { SlidersHorizontal, ListFilter, Settings2, Clock } from "@lucide/astro";

//components
import Badge from "@/components/micros/Badge.astro";
import SearchMealCard from "@/components/blocks/SearchMealCard.astro";
---

<Layout
  title="Search Meals | MealsDB"
  description="Search for your favorite meals and recipes on MealsDB."
>

  <section class="mx-auto flex max-w-6xl flex-col gap-8 mb-16">
    <!-- Page Heading & Search Bar -->
    <header class="flex flex-col gap-6">
      <div class="flex flex-col gap-3 text-center">
        <h1
          class="text-text-main-dark text-4xl sm:text-5xl font-black leading-tight tracking-[-0.033em]"
        >
          Find Your Next Meal
        </h1>
        <p
          class="text-text-secondary-dark text-lg font-normal leading-normal"
        >
          Search for a meal, ingredient, or cuisine...
        </p>
      </div>
      <div class="relative">
        <div id="searchbox"></div>
        <!-- <label class="flex flex-col min-w-40 h-14 w-full">
          <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
            <div
              class="text-text-light dark:text-text-dark flex bg-card-light dark:bg-card-dark items-center justify-center pl-4 rounded-l-lg border-y border-l border-border-light dark:border-border-dark"
            >
              <span class="material-symbols-outlined">search</span>
            </div>
            <input
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-text-main-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border-y border-r border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark focus:border-primary/50 h-full placeholder:text-text-secondary-dark px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal"
              placeholder="Search for meals, cuisines, ingredients..."
              value="Chicken"
            />
            <button
              aria-label="Clear search"
              class="text-text-secondary-dark absolute right-4 top-1/2 -translate-y-1/2 hover:text-text-main-dark"
            >
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
        </label>
      </div> -->
      </div>
    </header>
  </section>

  <!-- Search Loader -->
  <div id="search-loader" class="flex justify-center my-20">
    <div class="loader ease-linear rounded-full border-8 border-t-8 border-border-light dark:border-border-dark h-16 w-16"></div>
  </div>
  
  <!-- Search Results -->
  <div
    id="search-results"
    style="display: none;"
  >
    <section class="flex flex-col gap-6 my-10">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-bold text-text-main-dark" id="stats"></h2>
        <div class="flex items-center gap-2">
          <label class="text-sm text-text-secondary-dark" for="sort"
            >Sort by:</label
          >
          <select
            class="form-select bg-surface-dark border-border-dark rounded-md text-sm text-text-main-dark focus:ring-primary/50 focus:border-primary/50"
            id="sort"
            name="sort"
          >
            <option>Relevance</option>
            <option>Newest</option>
            <option>Cooking Time</option>
          </select>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12">
      <div class="col-span-4 lg:col-span-3 space-y-8">
        <!-- Category Filter -->
        <div
          class="flex flex-col rounded-lg border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark group"
        >
          <header
            class="flex cursor-pointer list-none items-center justify-between gap-6 p-4"
          >
            <div class="flex items-center gap-3">
              <SlidersHorizontal />
              <p
                class="text-text-main-dark text-base font-semibold leading-normal"
              >
                Categories
              </p>
            </div>
          </header>
          <div
            class="border-t border-border-light dark:border-border-dark p-6 gap-8"
          >
            <div id="category-list"></div>
          </div>
        </div>

        <!-- Cuisine Filter -->
        <div
          class="flex flex-col rounded-lg border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark group"
        >
          <header
            class="flex cursor-pointer list-none items-center justify-between gap-6 p-4"
          >
            <div class="flex items-center gap-3">
              <ListFilter />
              <p
                class="text-text-main-dark text-base font-semibold leading-normal"
              >
                Cuisine
              </p>
            </div>
          </header>
          <div
            class="border-t border-border-light dark:border-border-dark p-6 gap-8"
          >
            <div id="cuisine-list"></div>
          </div>
        </div>

        <!-- Cuisine Filter -->
        <div
          class="flex flex-col rounded-lg border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark group"
        >
          <header
            class="flex cursor-pointer list-none items-center justify-between gap-6 p-4"
          >
            <div class="flex items-center gap-3">
              <Settings2 />
              <p
                class="text-text-main-dark text-base font-semibold leading-normal"
              >
                Servings
              </p>
            </div>
          </header>
          <div
            class="border-t border-border-light dark:border-border-dark p-6 gap-8"
          >
            <div id="servings-slider"></div>
          </div>
        </div>

        <!-- <h5>Tags</h5>
        <div id="tag-list"></div> -->
        <div id="clear-refinements"></div>
      </div>

      <div class="col-span-4 lg:col-span-9">
        <!-- Results Grid -->
        <div id="hits"></div>
        <!-- Pagination -->
        <div id="pagination" class="mt-10"></div>
      </div>
    </div>
  </div>

  <script>
    import { algoliasearch } from "algoliasearch";
    import instantsearch from "instantsearch.js";
    import {
      searchBox,
      hits,
      pagination,
      refinementList,
      clearRefinements,
      rangeSlider,
      stats,
      configure,
    } from "instantsearch.js/es/widgets";

    const searchClient = algoliasearch(
      "GC5TS4PFK2",
      "05ab21682a73a5f888b8d2f92ddfbd06"
    );

    const search = instantsearch({
      indexName: "astro_mealsdb_content",
      searchClient,
    });

    search.on("render", () => {
      // Add any custom behavior after each render if needed
      document.getElementById('search-loader').style.display = 'none';
    document.getElementById('search-results').style.display = '';
    });

    // Search box widget
    search.addWidgets([
      searchBox({
        container: "#searchbox",
        placeholder: "Search for products...",
        cssClasses: {
          form: "relative",
          input:
            "relative w-full h-14 px-4 pl-12 transition-all border rounded outline-none focus:outline-none focus:ring-2 focus:ring-green-600/50 focus:border-transparent peer border-slate-200 text-slate-500 autofill:bg-white invalid:border-pink-500 invalid:text-pink-500 focus:border-emerald-500 focus:outline-none invalid:focus:border-pink-500 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-400",
          submit:
            "absolute left-0.5 top-3 bg-transparent text-slate-800 px-4 py-1 rounded",
          reset: "absolute right-16 top-2 text-slate-800 px-2 py-1 rounded",
          submitIcon: "w-6 h-6",
          resetIcon: "w-6 h-6",
        },
        templates: {
          submit:
            '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
          reset: "",
        },
      }),
    ]);

    // Configure default search parameters
    search.addWidgets([
      configure({
        hitsPerPage: 12,
        // Example: filter for multiple keywords (dessert OR breakfast)
        // filters: 'keywords:dessert OR keywords:breakfast',
        //filters: 'isDifficulty:true',

      }),
    ]);

    // Stats widget
    search.addWidgets([
      stats({
        container: "#stats",
        templates: {
          text(data) {
            let count = "";
            if (data.hasManyResults) {
              count += `Showing ${data.nbHits} results`;
            } else if (data.hasOneResult) {
              count += `1 result`;
            } else {
              count += `no result`;
            }
            return `${count} found`;
          },
        },
      }),
    ]);

    // Hits widget
    search.addWidgets([
      hits({
        container: "#hits",
        templates: {
          item(hit, { html, components }) {
            return `
          <a
              class="flex flex-col overflow-hidden rounded-xl border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark group cursor-pointer transition-all duration-300 transform hover:-translate-y-1"
              href="/recipe/${hit.slug}"
            >
              <div class="relative">
                ${
                  hit.thumbnail
                    ? `
                  <img src="${hit.thumbnail}" alt="${hit.title}" class="h-48 w-full object-cover" />
                `
                    : ""
                }
                <div
                  class="absolute top-3 right-3 flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-full bg-background-dark/70 px-3 backdrop-blur-sm"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
                  <p class="text-white text-sm font-medium leading-normal">${hit.addons?.prepTime} min</p>
                  <p class="text-white text-sm font-medium leading-normal hidden">${hit.addons?.cookTime} min</p>
                </div>
              </div>
              <div class="flex flex-col gap-3 p-4">
                <div class="flex gap-2 justify-between">
                  ${
                    hit.category
                      ? `
                  <span class="text-xs font-semibold uppercase tracking-wider text-primary">${hit.category}</span>
                `
                      : ""
                  }
                ${
                  hit.cuisine
                    ? `
                  <span class="text-xs font-semibold uppercase tracking-wider text-text-secondary-dark">${hit.cuisine}</span>
                `
                    : ""
                }
                </div>
                <h3
                  class="text-lg font-bold leading-tight text-text-main-dark"
                >
                  ${hit._highlightResult?.title?.value || hit.title}
                </h3>
                <p class="text-sm text-text-secondary-dark line-clamp-2">
                  ${hit._highlightResult?.description?.value || hit.description}
                  A delicious and easy-to-follow recipe that brings together fresh ingredients and bold flavors for a satisfying meal.
                </p>
              </div>
            </a>
          `;
          },
          empty(results) {
            return `
            <div
              class="sm:col-span-2 lg:col-span-3 flex flex-col items-center justify-center text-center gap-4 py-16 px-6 bg-surface-dark rounded-xl border border-dashed border-border-dark"
            >
              <span
                class="material-symbols-outlined text-5xl text-text-secondary-dark"
                >search_off</span
              >
              <h3 class="text-xl font-bold text-text-main-dark">
                No Results Found for query <strong class="text-primary">${results.query}</strong>
              </h3>
              <p class="text-text-secondary-dark max-w-sm">
                We couldn't find any meals matching your search. Try a different
                search term or adjust your filters.
              </p>
            </div>
          `;
          },
        },
        cssClasses: {
          list: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6",
          item: "col-span-1",
        },
      }),
    ]);

    // Refinement lists (filters)
    search.addWidgets([
      refinementList({
        container: "#category-list",
        attribute: "category",
        searchable: false,
        searchablePlaceholder: "Search categories...",
        showMore: false,
        templates: {
          item: `
            <label class="flex items-center gap-2 p-2 hover:bg-surface-dark rounded cursor-pointer">
              <input type="checkbox" {{#isRefined}}checked{{/isRefined}} class="rounded border-border-dark checked:bg-primary">
              <span class="text-text-main-dark">{{label}}</span>
              <span class="text-xs text-text-main-dark bg-border-light dark:bg-border-dark px-2 py-1 rounded-full ml-auto">{{count}}</span>
            </label>
          `,
          showMoreText: `
            <button class="text-primary hover:text-primary/80 text-sm font-medium mt-2">
              {{#isShowingMore}}Show Less{{/isShowingMore}}
              {{^isShowingMore}}Show More{{/isShowingMore}}
            </button>
          `,
          noResults:
            '<div class="text-text-secondary-dark text-sm">No categories found</div>',
        },
      }),
    ]);
    search.addWidgets([
      refinementList({
        container: "#cuisine-list",
        attribute: "cuisine",
        searchable: false,
        searchablePlaceholder: "Search cuisines...",
        showMore: true,
        templates: {
          item: `
            <label class="flex items-center gap-2 p-2 hover:bg-surface-dark rounded cursor-pointer">
              <input type="checkbox" {{#isRefined}}checked{{/isRefined}} class="rounded border-border-dark checked:bg-primary">
              <span class="text-text-main-dark">{{label}}</span>
              <span class="text-xs text-text-main-dark bg-border-light dark:bg-border-dark px-2 py-1 rounded-full ml-auto">{{count}}</span>
            </label>
          `,
          showMoreText: `
            <button class="text-primary hover:text-primary/80 text-sm font-medium mt-2">
              {{#isShowingMore}}Show Less{{/isShowingMore}}
              {{^isShowingMore}}Show More{{/isShowingMore}}
            </button>
          `,
          noResults:
            '<div class="text-text-secondary-dark text-sm">No cuisines found</div>',
        },
      }),
    ]);

    // search.addWidgets([
    //   refinementList({
    //     container: "#tag-list",
    //     attribute: "tags",
    //     searchable: false,
    //     searchablePlaceholder: "Search tags...",
    //     showMore: true,
    //     limit: 5,
    //   }),
    // ]);

    //servings slider filter
    search.addWidgets([
      rangeSlider({
        container: "#servings-slider",
        attribute: "addons.servings",
        min: 1,
        max: 12,
        precision: 0,
        tooltips: {
          format: function(rawValue) {
            return Math.round(rawValue) + (Math.round(rawValue) === 1 ? ' serving' : ' servings');
          }
        },
        // cssClasses: {
        //   root: "flex flex-col gap-3",
        //   handle: "bg-primary border-2 border-primary rounded-full shadow-md",
        //   track: "bg-border-light dark:bg-border-dark h-2 rounded-full",
        //   connect: "bg-primary",
        //   tooltip: "bg-primary text-white px-2 py-1 rounded text-xs font-medium"
        // },
      }),
    ]);

    // Clear refinements button
    search.addWidgets([
      clearRefinements({
        container: "#clear-refinements",
        templates: {
          resetLabel({ hasRefinements }) {
            return `<button class="flex min-w-[84px] cursor-pointer items-center justify-center rounded-lg h-10 px-4 bg-border-light text-text-main-dark text-sm font-bold hover:bg-border-light/80 transition-colors"> <span class="truncate">Clear All ${hasRefinements ? "✕" : ""}</span> </button>`;
          },
        },
      }),
    ]);

    // Pagination widget
    search.addWidgets([
      pagination({
        container: "#pagination",
        padding: 2, // Number of page numbers to show around current page
        showFirst: true, // Show first page button
        showLast: true, // Show last page button
        showPrevious: true, // Show previous button
        showNext: true, // Show next button
        // Custom templates for prev/next buttons
        templates: {
          previous: `
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill="none" d="M0 0h24v24H0z"></path><path d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z"></path></svg>
    `,
          next: `
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill="none" d="M0 0h24v24H0z"></path><path d="M13.1717 12.0007L8.22192 7.05093L9.63614 5.63672L16.0001 12.0007L9.63614 18.3646L8.22192 16.9504L13.1717 12.0007Z"></path></svg>
    `,
          first: `
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill="none" d="M0 0h24v24H0z"></path><path d="M4.83582 12L11.0429 18.2071L12.4571 16.7929L7.66424 12L12.4571 7.20712L11.0429 5.79291L4.83582 12ZM10.4857 12L16.6928 18.2071L18.107 16.7929L13.3141 12L18.107 7.20712L16.6928 5.79291L10.4857 12Z"></path></svg>
    `,
          last: `
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill="none" d="M0 0h24v24H0z"></path><path d="M19.1642 12L12.9571 5.79291L11.5429 7.20712L16.3358 12L11.5429 16.7929L12.9571 18.2071L19.1642 12ZM13.5143 12L7.30722 5.79291L5.89301 7.20712L10.6859 12L5.89301 16.7929L7.30722 18.2071L13.5143 12Z"></path></svg>
    `,
        },
        cssClasses: {
          list: "flex items-center justify-center text-sm list-none md:gap-1 text-slate-700",
          item: "",
          link: "flex h-10 w-10 items-center justify-center rounded-lg bg-surface-dark text-text-light border border-transparent dark:text-text-dark font-bold text-sm hover:border-primary hover:text-primary hover:bg-primary/5 transition-colors group-[.ais-Pagination-item--selected]:bg-primary group-[.ais-Pagination-item--selected]:border-primary group-[.ais-Pagination-item--selected]:text-text-light",
          selectedItem: "group",
          disabledItem: "text-gray-400 cursor-not-allowed",
          firstPageItem: "mr-1",
          lastPageItem: "ml-1",
          previousPageItem: "mr-1",
          nextPageItem: "ml-1",
        },
      }),
    ]);

    search.start();
  </script>
</Layout>
