//components
import Card from "@/components/ui/Card.astro";

//interface
interface Props {
  categories: { strCategory: string }[];
  areas: { strArea: string }[];
}

//props
const { categories, areas } = Astro.props;

//const categories = [...new Set(meals.map((meal) => meal.category))];
---

<!-- Filterable Meal Grid -->
<section class="py-12" data-scroll-animate>
  <!-- Section Header -->
  <h2
    class="text-text-light dark:text-text-dark text-[22px] font-bold leading-tight tracking-[-0.015em] pb-4"
    data-scroll-animate
  >
    Discover Meals
  </h2>
  <!-- Filters and Toolbar -->
  <div
    class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 py-3 border-y border-border-light dark:border-border-dark mb-8"
    data-scroll-animate
  >
    <div class="flex flex-wrap gap-3">
      <UISelect
        items={categories.map((category) => ({
          value: category.strCategory,
          label: category.strCategory,
        }))}
        placeholder="Category"
      />

      <UISelect
        items={areas.map((area) => ({
          value: area.strArea,
          label: area.strArea,
        }))}
        placeholder="Cuisine"
      />
    </div>
    <div class="flex items-center gap-2">
      <p class="text-sm font-medium mr-2 hidden sm:block">View:</p>
      <button class="p-2 rounded-lg bg-primary/20 text-primary">
        <span class="material-symbols-outlined">grid_view</span>
      </button>
      <button
        class="p-2 rounded-lg hover:bg-primary/20 text-text-light dark:text-text-dark/70 hover:text-primary dark:hover:text-primary transition-colors"
      >
        <span class="material-symbols-outlined">view_list</span>
      </button>
    </div>
  </div>
  <!-- Meal Grid -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
  >
    {
      meals.map((meal) => (
        <Card
          title={meal.name}
          category={meal.category}
          cuisine={meal.cuisine}
          imageUrl={meal.imageUrl}
          alt={meal.alt}
        />
      ))
    }
  </div>
  <!-- Pagination -->
  <nav aria-label="Pagination" class="flex items-center justify-center pt-16">
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg border border-border-light dark:border-border-dark text-sm font-medium hover:bg-primary/20 transition-colors"
      href="#"
    >
      <span class="material-symbols-outlined text-base">chevron_left</span>
    </a>
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg bg-primary text-text-light text-sm font-bold mx-1"
      href="#">1</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">2</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">3</a
    >
    <span
      class="inline-flex items-center justify-center size-9 text-sm font-medium mx-1"
      >...</span
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors mx-1"
      href="#">10</a
    >
    <a
      class="inline-flex items-center justify-center size-9 rounded-lg border border-border-light dark:border-border-dark text-sm font-medium hover:bg-primary/20 transition-colors"
      href="#"
    >
      <span class="material-symbols-outlined text-base">chevron_right</span>
    </a>
  </nav>
</section>
