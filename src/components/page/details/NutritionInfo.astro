---
interface Props {
    nutrition: {
        calories: string;
        fat: string;
        carbs: string;
        protein: string;
    };
}

const { nutrition } = Astro.props;
const { calories, fat, carbs, protein } = nutrition;
---

<div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm print:p-0 print:shadow-none print:text-black">
  <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
    Nutritional Information
  </h3>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
    Approximate values per serving.
  </p>
  <div class="space-y-3">
    <div
      class="flex justify-between items-center text-gray-700 dark:text-gray-300"
    >
      <p>Calories</p>
      <p class="font-semibold text-gray-900 dark:text-gray-100">{calories}</p>
    </div>
    <div class="w-full h-px bg-gray-200 dark:bg-gray-700"></div>
    <div
      class="flex justify-between items-center text-gray-700 dark:text-gray-300"
    >
      <p>Protein</p>
      <p class="font-semibold text-gray-900 dark:text-gray-100">{protein}</p>
    </div>
    <div class="w-full h-px bg-gray-200 dark:bg-gray-700"></div>
    <div
      class="flex justify-between items-center text-gray-700 dark:text-gray-300"
    >
      <p>Fat</p>
      <p class="font-semibold text-gray-900 dark:text-gray-100">{fat}</p>
    </div>
    <div class="w-full h-px bg-gray-200 dark:bg-gray-700"></div>
    <div
      class="flex justify-between items-center text-gray-700 dark:text-gray-300"
    >
      <p>Carbohydrates</p>
      <p class="font-semibold text-gray-900 dark:text-gray-100">{carbs}</p>
    </div>
  </div>
</div>
