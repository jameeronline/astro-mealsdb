---
interface TeamMember {
  name: string;
  role: string;
  image: string;
  quote: string;
  alt: string;
}

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<div class="flex flex-col items-center text-center" data-scroll-animate>
  <img
    class="mb-4 size-32 rounded-full object-cover"
    alt={`Photo of ${member.name}, ${member.role}`}
    src={member.image}
    data-scroll-animate
  />
  <h3 class="text-lg font-bold text-text-light dark:text-text-dark" data-scroll-animate>
    {member.name}
  </h3>
  <p class="text-sm font-medium text-primary" data-scroll-animate>{member.role}</p>
  <p class="mt-2 text-sm text-text-light/60 dark:text-text-dark/60" data-scroll-animate>
    "{member.quote}"
  </p>
</div>
