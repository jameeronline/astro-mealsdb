---
import axios from "axios";

import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/blocks/Hero.astro";
import FilteredMeals from "@/components/blocks/FilteredMeals.astro";
import FeatureMealCard from "@/components/blocks/FeatureMealCard.astro";

//import collections
import { categories, cuisines } from "../utils/index";

const categoryValues = categories.map(item => item.data);
const cuisineValues = cuisines.map(item => item.data);

---

<Layout>
  <Hero />
  <!-- <FeatureMealCard /> -->
  <FilteredMeals categories={categoryValues} cuisines={cuisineValues} />
</Layout>
