---
import { Image } from "astro:assets";
import type { GetStaticPaths, Page } from "astro";

//import type
//import type { Ingredient } from "src/data/recipes";

interface Props {
  page: Page;
}

//import layout
import Layout from "src/layouts/Layout.astro";
import PageHeader from "@/components/blocks/PageHeader.astro";
import Pagination from "@/components/Pagination.astro";

//get ingredients collection
import { ingredients } from "@/utils/index";
//const ingredientsData = ingredients.map((ing) => ing.data);

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  return paginate(ingredients, { pageSize: 30 });
};

//props
const { page } = Astro.props;
const ingredientsData = page?.data;
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- page header -->
    <PageHeader
      title="Ingredients"
      description="Discover and learn about the diverse ingredients featured in our recipes, from everyday staples to unique flavors."
    />
    <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 py-4">
      {
        ingredientsData.map((ingredient) => (
          <div class="flex flex-col items-center bg-card-light dark:bg-card-dark rounded-lg p-4 shadow hover:shadow-lg transition-shadow" data-scroll-animate>
            <Image
              src={ingredient.data.thumbnail}
              alt={ingredient.data.title}
              width={300}
              height={300}
              class="object-cover rounded-full mb-2"
              data-scroll-animate
            />
            <h3 class="text-base font-semibold text-text-light dark:text-white mb-1">
              {ingredient.data.title}
            </h3>
          </div>
        ))
      }
    </div>
    <Pagination page={page} />
  </div>
</Layout>
