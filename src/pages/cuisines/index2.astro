---
// Disable pre rendering for dynamic search results
export const prerender = false;

import { Image } from "astro:assets";
import { getCollection } from "astro:content";

//components import
import CategoryCard from "@/components/blocks/CategoryCard.astro";

// Get sort parameter from URL
// Get the search term from the URL query
const url = new URL(Astro.request.url);
const sortParam = url.searchParams.get("sort") || "default";

// Get all cuisines
const allCuisines = await getCollection("cuisines");

// Sort cuisines based on URL parameter
let cuisines = [...allCuisines];
if (sortParam === "a-z") {
  cuisines.sort((a, b) => a.data.title.localeCompare(b.data.title));
} else if (sortParam === "z-a") {
  cuisines.sort((a, b) => b.data.title.localeCompare(a.data.title));
}

//layout import
import Layout from "src/layouts/Layout.astro";
import Pagination from "@/components/Pagination.astro";
import PageHeader from "src/components/blocks/PageHeader.astro";
---

<Layout
  title="Cuisines"
  description="Explore a variety of meal cuisines to find your next favorite recipe."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- PageHeader -->
    <PageHeader title="Browse All Meal Cuisines" description="Discover a world of flavors from every corner of the globe. Browse our curated selection of meal cuisines to inspire your next culinary adventure." />

    <!-- Sort Controls -->
    <div class="flex flex-wrap items-center justify-between gap-3 py-3 mb-6">
      <!-- <form class="max-w-md mx-auto mb-8" method="GET"> -->
      <div class="text-text-light dark:text-text-dark text-sm font-medium">
        Sort by:
        <select
          id="sortSelect"
          name="sort"
          class="ml-2 form-select bg-card-light dark:bg-card-dark text-text-light dark:text-text-dark border border-border-light dark:border-border-dark rounded-md"
          value={sortParam}
        >
          <option value="default" selected={sortParam === "default"}
            >Default</option
          >
          <option value="a-z" selected={sortParam === "a-z"}>Title (A-Z)</option
          >
          <option value="z-a" selected={sortParam === "z-a"}>Title (Z-A)</option
          >
        </select>
        <!-- <button
          type="submit"
          class=""
          >Search</button
        > -->
      </div>
      <!-- </form> -->
      <div class="text-text-muted-light dark:text-text-muted-dark text-sm">
        {cuisines.length} cuisines found
      </div>
    </div>

    <!-- Cuisine Grid -->
    <div
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6"
      data-scroll-animate
    >
      {
        cuisines.map((cuisine) => (
          <CategoryCard cuisine={cuisine} type="cuisines" />
        ))
      }
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sortSelect = document.getElementById(
      "sortSelect"
    ) as HTMLSelectElement;

    if (sortSelect) {
      sortSelect.addEventListener("change", function (e) {
        const target = e.target as HTMLSelectElement;
        const selectedSort = target.value;
        const url = new URL(window.location.href);

        // Update URL with sort parameter
        if (selectedSort === "default") {
          url.searchParams.delete("sort");
        } else {
          url.searchParams.set("sort", selectedSort);
        }

        // Navigate to the updated URL
        window.location.href = url.toString();
      });
    }
  });
</script>
