    <div class="flex flex-col w-full flex-1">
      <!-- Breadcrumbs -->
      <div class="flex flex-wrap gap-2 pb-8 print:hidden">
        <a
          class="text-gray-600 dark:text-gray-400 text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary"
          href="#">Home</a
        >
        <span
          class="text-gray-600 dark:text-gray-400 text-sm font-medium leading-normal"
          >/</span
        >
        <a
