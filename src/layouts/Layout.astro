---
//fonts
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/work-sans";

//styles
import "../styles/global.css";

//components
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

//scripts
import LocalScript from "@/scripts/LocalScript.astro";
import ScrollAnimate from "@/scripts/ScrollAnimate.astro";

//page metadata
const {
  title = "MealsDB | Find your next meal",
  description = "Discover and share delicious recipes from around the world.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth scroll-animation">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-text-light dark:text-text-dark grid grid-cols-1 grid-rows-[auto_1fr_auto] min-h-full"
  >
    <Header />
    <main class="container mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
    <!-- <LocalScript /> -->
    <ScrollAnimate />
    <script src="src/scripts/global.js"></script>
  </body>
</html>
