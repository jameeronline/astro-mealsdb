---
export interface Props {
  title: string;
  imageUrl: string;
  imageAlt: string;
  category: string;
  area?: string;
  href: string;
}

//import astro components
import Image from "astro/components/Image.astro";

//props
const { title, imageUrl, imageAlt, category, area, href } = Astro.props;
---

<div
  class="group flex flex-col overflow-hidden rounded-xl bg-card-light dark:bg-card-dark border border-border-light dark:border-border-dark shadow-sm transition-all hover:shadow-lg dark:hover:shadow-primary/20"
  data-scroll-animate
>
  <Image
    class="h-48 w-full object-cover transition-transform group-hover:scale-105"
    alt={imageAlt || `${title} recipe image`}
    src={imageUrl}
    width={400}
    height={192}
  />
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-center gap-2 mb-2">
      <span
        class="text-xs font-semibold uppercase tracking-wider bg-primary/20 text-primary py-1 px-2 rounded-full"
      >
        {category}
      </span>
      {
        area && (
          <span class="text-xs font-semibold uppercase tracking-wider bg-primary/20 text-primary py-1 px-2 rounded-full">
            {area}
          </span>
        )
      }
    </div>
    <h3 class="text-lg font-bold">{title}</h3>
    <div class="mt-auto pt-4">
      <a
        class="w-full text-center flex items-center justify-center rounded-lg h-10 px-4 bg-primary text-text-light text-sm font-bold tracking-[0.015em]"
        href={"/details"}
      >
        View Recipe
      </a>
    </div>
  </div>
</div>
