---

<Layout
  title="Search Meals | MealsDB"
  description="Search for your favorite meals and recipes on MealsDB."
>
  <div class="py-16">
    <div class="layout-content-container mx-auto flex max-w-6xl flex-col gap-8">
      <!-- Page Heading & Search Bar -->
      <section class="flex flex-col gap-6">
        <div class="flex flex-col gap-3 text-center">
          <h1
            class="text-text-main-dark text-4xl sm:text-5xl font-black leading-tight tracking-[-0.033em]"
          >
            Find Your Next Meal
          </h1>
          <p
            class="text-text-secondary-dark text-lg font-normal leading-normal"
          >
            Search for a meal, ingredient, or cuisine...
          </p>
        </div>
        <div class="relative">
          <div id="searchbox"></div>
          <!-- <label class="flex flex-col min-w-40 h-14 w-full">
            <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
              <div
                class="text-text-light dark:text-text-dark flex bg-card-light dark:bg-card-dark items-center justify-center pl-4 rounded-l-lg border-y border-l border-border-light dark:border-border-dark"
