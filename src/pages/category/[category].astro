---
import { getCollection } from "astro:content";
import Image from "astro/components/Image.astro";

//layout import
import Layout from "src/layouts/Layout.astro";

//components import
import MealsCard from "src/components/blocks/MealsCard.astro";
import SimpleMealCard from "src/components/blocks/SimpleMealCard.astro";

//fetch categories for category tags
const categories = await getCollection("categories");

//generate static paths for each category
export async function getStaticPaths() {
  const categories = await getCollection("categories");

  return categories.map((category) => ({
    params: { category: category.data.value },
    props: { category: category.data },
  }));
}

//props
const { category } = Astro.props;
const selectedCategory = category.value.toLocaleLowerCase();

//fetch recipes based on selected category
const allRecipes = await getCollection("recipes");
const categoryRecipes = allRecipes.filter(recipe => 
  recipe.data.category.toLocaleLowerCase() === selectedCategory
);

console.log(`Found ${categoryRecipes.length} recipes for category: ${selectedCategory}`);
---

<Layout>
  <div class="py-8 md:py-16">
    <div class="flex flex-wrap justify-between gap-3 py-4 mb-6">
      <div class="flex min-w-72 flex-col gap-3">
        <p
          class="text-text-light dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]"
        >
          Browse Meal Categories
        </p>
        <p
          class="text-text-muted-light dark:text-[#a3b99d] text-base font-normal leading-normal"
        >
          Select a category to discover delicious new recipes.
        </p>
      </div>
    </div>

    <!-- Category Tags -->
    <div class="flex gap-3 py-3 mb-6">
      {
        categories.map((category) => (
          <a
            href={`/category/${category.data.value}`}
            page-active={
              category.data.value === selectedCategory ? "true" : "false"
            }
            class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-full bg-card-light dark:bg-card-dark pl-4 pr-4 hover:bg-primary/20 hover:border-primary-dark transition-colors border border-border-light dark:border-card-dark  [&[page-active='true']]:text-background-dark dark:[&[page-active='true']]:text-background-light [&[page-active='true']]:border-primary  [&[page-active='true']]:bg-primary"
          >
            <p class="text-text-light dark:text-white text-sm font-medium leading-normal">
              {category.data?.label && category.data.label}
            </p>
          </a>
        ))
      }
    </div>
    <h2
      class="text-text-light dark:text-primary/80 text-2xl font-bold leading-tight tracking-tight pb-3 pt-5"
    >
      {category.label && category.label} Recipes
    </h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 py-4" data-scroll-animate>
      {
        categoryRecipes.map((recipe) => (
          <MealsCard recipe={recipe.data} />
          // <SimpleMealCard recipe={recipe.data} />
        ))
      }
    </div>
