---
import Image from 'astro/components/Image.astro';

interface Props {
  thumbnail: string;
  title: string;
  description: string;
}   

const {thumbnail, title, description} = Astro.props;
---

<!-- Hero Section -->
      <div class="@container mb-8">
        <div
          class="relative h-[480px] w-full rounded-xl overflow-hidden flex items-end "
            data-scroll-animate
        >
          <Image src={thumbnail} alt={title} width="100%" height="480" class="absolute inset-0 w-full h-full object-cover" />
          <div class="flex flex-col p-6 md:p-8 relative w-full bg-gradient-to-t from-black/70 to-transparent">
            <h1
              class="text-white tracking-tight text-3xl md:text-5xl font-bold leading-tight"
              data-scroll-animate
            >
              {title}
            </h1>
            <p
              class="text-gray-200 text-base font-normal leading-normal max-w-2xl mt-2"
              data-scroll-animate
            >
             {description}
            </p>
          </div>
        </div>
      </div>